      <formula_string>(customer_id != null &amp;&amp; member_no != null) ? "WEB_DAN_MEMBER" : (member_no == null ? "WEB_SAJA" : "MEMBER_SAJA")</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
