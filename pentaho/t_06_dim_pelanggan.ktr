    <sql>SELECT c.customer_id, c.full_name, c.phone, c.gender, a.city
FROM customers c
LEFT JOIN customer_addresses a
       ON a.customer_id = c.customer_id
      AND a.is_primary  = 1;   -- aturan: kota pelanggan = kota alamat utama</sql>
