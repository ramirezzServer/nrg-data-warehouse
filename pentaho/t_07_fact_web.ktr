    <connection>nrg_ecom_src</connection>
    <sql>SELECT oi.order_item_id, oi.order_id, oi.line_no, oi.sku, oi.qty,
       oi.unit_price, oi.disc_amount,
       o.customer_id, o.order_ts, o.status, o.voucher_id
FROM order_items oi
JOIN orders o ON o.order_id = oi.order_id;</sql>
    <limit>0</limit>
    <lookup/>
