    <formula>
      <field_name>tanggal_key</field_name>
      <formula_string>thn.longValue() * 10000L + bln.longValue() * 100L + hr.longValue()</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>promo_key</field_name>
      <formula_string>diskon.doubleValue() == 0 ? -1L : (promo_kanal != null ? promo_kanal.longValue() : (promo_semua != null ? promo_semua.longValue() : -2L))</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
