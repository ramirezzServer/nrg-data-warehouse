    <connection>nrg_ecom_src</connection>
    <sql>SELECT p.sku, p.product_name, p.brand,
       c.category_name  AS sub_kategori,
       pc.category_name AS kategori
FROM products p
JOIN categories c       ON c.category_id  = p.category_id
LEFT JOIN categories pc ON pc.category_id = c.parent_category_id;</sql>
