        <stream_name>tanggal</stream_name>
      </field>
      <field>
        <column_name>hari_dalam_bulan</column_name>
        <stream_name>hari_dalam_bulan</stream_name>
      </field>
      <field>
        <column_name>minggu_ke</column_name>
        <stream_name>minggu_ke</stream_name>
      </field>
      <field>
        <column_name>bulan</column_name>
        <stream_name>bulan</stream_name>
      </field>
      <field>
        <column_name>kuartal</column_name>
