      <xloc>1200</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>User defined Java expression</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>tanggal_key</field_name>
      <formula_string>tahun.longValue()*10000L + bulan.longValue()*100L + hari_dalam_bulan.longValue()</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>nama_hari</field_name>
      <formula_string>new String[]{"Minggu","Senin","Selasa","Rabu","Kamis","Jumat","Sabtu"}[(int) hari_minggu.longValue() - 1]</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>is_akhir_pekan</field_name>
      <formula_string>   (hari_minggu.longValue() == 1 || hari_minggu.longValue() == 7) ? 1L : 0L</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>nama_bulan</field_name>
      <formula_string>new String[]{"Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"}[(int) bulan.longValue() - 1]</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>tahun_kuartal</field_name>
      <formula_string>tahun.longValue() + "-Q" + kuartal.longValue()</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>tahun_bulan</field_name>
      <formula_string>tahun.longValue() + "-" + (bulan.longValue() &lt; 10 ? "0" : "") + bulan.longValue()</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
