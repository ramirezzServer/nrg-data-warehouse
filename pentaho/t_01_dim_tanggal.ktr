        <stream_name>tanggal_key</stream_name>
      </field>
      <field>
        <column_name>nama_hari</column_name>
        <stream_name>nama_hari</stream_name>
      </field>
      <field>
        <column_name>is_akhir_pekan</column_name>
        <stream_name>is_akhir_pekan</stream_name>
      </field>
      <field>
        <column_name>nama_bulan</column_name>
        <stream_name>nama_bulan</stream_name>
      </field>
      <field>
        <column_name>tahun_kuartal</column_name>
        <stream_name>tahun_kuartal</stream_name>
